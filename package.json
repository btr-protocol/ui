{
  "name": "@btr-protocol/ui",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "description": "BTR shared UI kit: the btr.markets Preact components, layout shell, theme tokens and Tailwind preset. Source only, no build step.",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./layout": "./src/layout/index.ts",
    "./wallet": "./src/wallet/index.ts",
    "./wallet/WalletModal": "./src/wallet/WalletModal.tsx",
    "./wallet/AccountModal": "./src/wallet/AccountModal.tsx",
    "./wallet/*": "./src/wallet/*.ts",
    "./lib/notifications": "./src/lib/notifications.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles": "./src/styles/index.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./tailwind.preset": "./src/styles/tailwind.preset.js",
    "./assets/*": "./src/assets/*",
    "./charts": "./src/charts/index.ts"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0",
    "@btr-protocol/sdk": "github:btr-protocol/sdk"
  },
  "devDependencies": {
    "@btr-protocol/sdk": "github:btr-protocol/sdk#dc1d1f11d9d3aab7b38b5653e092c06bbd9efb3f",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "latest",
    "jsqr": "1.4.0",
    "preact-render-to-string": "^6.5.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btr-protocol/ui.git"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "@preact/signals": "^2.5.1",
    "lightweight-charts": "^5.0.9",
    "lucide-preact": "^0.468.0",
    "preact": "^10.22.0",
    "tailwind-merge": "^2.6.1"
  }
